  "type": "module",
  "bugs": {
    "url": "https://github.com/dirkmarski/quokka/issues"
  },
  "homepage": "https://github.com/dirkmarski/quokka#readme",
  "devDependencies": {
    "@types/node": "^24.13.6",
    "promptfoo": "0.124.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
